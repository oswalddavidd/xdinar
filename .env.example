# Newsletter provider (Mailchimp / Resend) — add when ready
RESEND_API_KEY=

# Contact form email destination
CONTACT_EMAIL=contact@xdinar.io

# CoinGecko API key (optional, for token price feed)
COINGECKO_API_KEY=

# Network: "testnet" (BSC Testnet, chain 97) or "mainnet" (BNB Smart Chain, chain 56).
# Defaults to testnet. Also controls the CSP connect-src, so redeploy after changing it.
NEXT_PUBLIC_NETWORK=testnet

# Optional private BSC mainnet RPC (e.g. from NodeReal / QuickNode / Ankr). Used before the
# public fallback when NEXT_PUBLIC_NETWORK=mainnet. Must be https.
NEXT_PUBLIC_BSC_RPC_URL=

# App URL
NEXT_PUBLIC_APP_URL=https://xdinar.vercel.app

# WalletConnect / Reown Project ID — get one at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=e1f182137e672cf220c754708b3f87c0
